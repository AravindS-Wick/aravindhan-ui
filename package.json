{
  "name": "@aravi1008/ui",
  "version": "1.5.0",
  "description": "A personal professional-grade design system — global CSS, themes, icons, utilities, components. One install, full project setup.",
  "author": "Aravindhan Sivaraman",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/index.css",
    "./tokens": "./dist/tokens/tokens.js",
    "./tokens/css": "./dist/tokens/variables.css",
    "./tokens/scss": "./dist/tokens/variables.scss",
    "./themes/*": "./dist/themes/*.css",
    "./components": {
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./icons": "./dist/icons/sprite.svg",
    "./icons/*": "./dist/icons/*.svg"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:tokens": "node tokens/build.js",
    "build:css": "rollup -c rollup.config.js",
    "build:icons": "node scripts/build-icons.js",
    "build:js": "rollup -c rollup.js.config.js",
    "build:types": "cp src/index.d.ts dist/index.d.ts && cp src/components.d.ts dist/components.d.ts",
    "build": "npm run build:tokens && npm run build:icons && npm run build:css && npm run build:js && npm run build:types",
    "dev": "rollup -c rollup.config.js --watch",
    "lint:js": "eslint tokens tests scripts src --ext .js,.ts",
    "lint:css": "stylelint 'src/**/*.{css,scss}'",
    "lint": "npm run lint:js && npm run lint:css",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run lint && npm run build",
    "release": "semantic-release"
  },
  "keywords": [
    "css",
    "design-system",
    "ui",
    "scss",
    "themes",
    "components",
    "utilities",
    "responsive",
    "icons",
    "design-tokens"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AravindS-Wick/aravindhan-ui.git"
  },
  "bugs": {
    "url": "https://github.com/AravindS-Wick/aravindhan-ui/issues"
  },
  "homepage": "https://github.com/AravindS-Wick/aravindhan-ui#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.0",
    "@semantic-release/npm": "^11.0.0",
    "autoprefixer": "^10.4.18",
    "cssnano": "^6.1.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.4.38",
    "postcss-scss": "^4.0.9",
    "rimraf": "^5.0.5",
    "rollup": "^4.13.0",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.72.0",
    "semantic-release": "^23.0.8",
    "style-dictionary": "^4.1.4",
    "stylelint": "^16.3.1",
    "stylelint-config-standard-scss": "^13.1.0"
  },
  "overrides": {
    "picomatch": "^4.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ]
}
