# @aravi1008/ui — Environment Variables Example
# Copy this file to .env for local development
# .env is gitignored — never commit real tokens/secrets

# ─── npm Publishing ───────────────────────────────────────────────────────────
# Your npm access token (from npmjs.com → Access Tokens)
# Used locally if you want to publish manually: npm publish
# In CI/CD, set this as a GitHub Actions secret (not here)
NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── GitHub (only needed for local semantic-release dry runs) ─────────────────
# Fine-grained personal access token from GitHub → Settings → Developer Settings
# Permissions needed: Contents (read/write), Issues (read/write), Pull Requests (read/write)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
